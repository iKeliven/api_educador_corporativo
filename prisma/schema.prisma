generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Journey {
  id          String   @id @default(uuid())
  company     String
  title       String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trails Trail[]
}

model Trail {
  id          String   @id @default(uuid())
  title       String
  description String?
  workload    String?
  link        String?
  order       Int

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}